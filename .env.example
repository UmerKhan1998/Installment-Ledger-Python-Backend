DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Option A: one connection URL (Neon, Supabase, ...). Takes priority over the POSTGRES_* vars.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Option B: separate variables
POSTGRES_DB=installment_ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Access token lives 15 minutes, refresh token 7 days (rotated + blacklisted on use)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Set to 1 to use SQLite instead of PostgreSQL (quick local testing only)
USE_SQLITE=0

# Firebase (accounts/firebase_auth.py, ledger/receipt_storage.py)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
# Receipt storage needs a service account (Project settings -> Service accounts -> Generate new private key):
FIREBASE_SERVICE_ACCOUNT_FILE=
# On Render, instead: FIREBASE_SERVICE_ACCOUNT_B64=<base64 of the JSON file>

# Gemini (server-side only). Get a key in Google AI Studio; restrict it to the Generative Language API.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
