DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Option A: one connection URL (Neon, Supabase, ...). Takes priority over the POSTGRES_* vars.
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&channel_binding=require

# Option B: separate variables
POSTGRES_DB=installment_ledger
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Access token lives 15 minutes, refresh token 7 days (rotated + blacklisted on use)
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# Set to 1 to use SQLite instead of PostgreSQL (quick local testing only)
USE_SQLITE=0
